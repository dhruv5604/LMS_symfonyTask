{% extends 'base.html.twig' %}

{% block title %}Add Country{% endblock %}

{% block body %}
<div class="container">
    <h1>Add Country</h1>

    {{ form_start(form) }}

    {{ form_row(form.name) }}

    <button type="submit" class="btn btn-primary">Add</button>

    {{ form_rest(form) }}

    {{ form_end(form) }}

    <a href="{{ path('app_country') }}">back to list</a>
</div>
    
{% endblock %}