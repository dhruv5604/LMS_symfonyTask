{% extends 'base.html.twig' %}

{% block title %}City List{% endblock %}

{% block body %}
    <h1 class="mb-4">City List</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <input type="search" name="name" value="{{ filters.name|default('') }}"
                           class="form-control" placeholder="Search by name" />
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">-- Status --</option>
                        <option value="1" {% if filters.status == '1' %}selected{% endif %}>Active</option>
                        <option value="0" {% if filters.status == '0' %}selected{% endif %}>Not Active</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="country" class="form-select">
                        <option value="">-- Country --</option>
                        {% for country in countries %}
                            <option value="{{ country.id }}"
                                {% if filters.country == country.id %}selected{% endif %}>
                                {{ country.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Search</button>
                    <a href="{{ path('app_city') }}" class="btn btn-outline-secondary">Reset</a>
                    <a href="{{ path('app_city_add') }}" class="btn btn-success">+ Add City</a>
                </div>
            </form>
        </div>
    </div>

    <a href="{{ path('app_index') }}" class="btn btn-primary">Homepage</a>

    <table class="table table-bordered align-middle mt-3">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Country</th>
                <th>Status</th>
                <th style="width: 150px;">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for city in cities %}
                <tr>
                    <td>{{ city.id }}</td>
                    <td>{{ city.name }}</td>
                    <td>{{ city.country.name }}</td>
                    <td>
                        <span class="badge {{ city.active ? 'bg-success' : 'bg-secondary' }}">
                            {{ city.active ? 'Active' : 'Not Active' }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('app_city_edit', {'id': city.id}) }}" class="btn btn-sm btn-primary">Edit</a>
                        <a href="{{ path('app_city_delete', {'id': city.id}) }}" class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure you want to delete this city?')">Delete</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">No cities found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
