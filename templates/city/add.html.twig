{% extends 'base.html.twig' %}

{% block title %}Add Cities{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Add Cities</h1>

    {% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message|raw }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}


    <form method="post">
        <div class="mb-3">
            <label for="country" class="form-label fw-semibold">Country</label>
            <select id="country" name="country" class="form-select" required>
                <option value="" disabled selected>Select a country</option>
                {% for country in countries %}
                    <option value="{{ country.id }}">{{ country.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-check mb-4">
            <label class="form-check-label" for="active">
                Active
            </label>
            <input class="form-check-input" type="checkbox" name="active" id="active" checked>
        </div>

        <label class="fw-semibold mb-2">City Name(s)</label>
        <div id="city-fields">
            <div class="city-group input-group mb-2">
                <input type="text" name="cities[]" class="form-control" placeholder="Enter city name" required>
                <button type="button" class="btn btn-danger remove-city">Delete</button>
            </div>
        </div>

        <button type="button" id="add-city" class="btn btn-outline-primary mb-4">+ Add More</button>

        <div>
            <button type="submit" class="btn btn-success">Add</button>
            <a href="{{ path('app_city') }}" class="btn btn-secondary ms-2">← Back to list</a>
        </div>
    </form>
</div>

<script>
    document.getElementById('add-city').addEventListener('click', function () {
        const container = document.getElementById('city-fields');
        const div = document.createElement('div');
        div.classList.add('city-group', 'input-group', 'mb-2');
        div.innerHTML = `
            <input type="text" name="cities[]" class="form-control" placeholder="Enter city name" required>
            <button type="button" class="btn btn-danger remove-city">Delete</button>
        `;
        container.appendChild(div);
    });

    document.getElementById('city-fields').addEventListener('click', function (e) {
        if (e.target.classList.contains('remove-city')) {
            const totalFields = document.querySelectorAll('#city-fields .city-group').length;
            if (totalFields > 1) {
                e.target.closest('.city-group').remove();
            } else {
                alert("At least one city is required.");
            }
        }
    });
</script>
{% endblock %}
